rules_version = '2';
// Jornada security rules. Copy ALL of this into Firebase > Firestore Database > Rules and press Publish.
// - Anyone can create an account, but sees nothing until an administrator approves them.
// - The first person to press "Become administrator" is the main administrator.
// - Only managers change the team, shifts and briefing.
// - Approved people can use channels; direct messages are readable only by their two participants.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function isMember() {
      return signedIn() && (exists(/databases/$(database)/documents/members/$(me()))
                            || exists(/databases/$(database)/documents/admins/$(me())));
    }
    function ownerId() { return get(/databases/$(database)/documents/meta/setup).data.owner; }
    function bootstrapping(uid) {
      return uid == me()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(/databases/$(database)/documents/meta/setup).data.owner == me();
    }

    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && existsAfter(/databases/$(database)/documents/admins/$(me()));
      allow update: if isAdmin() && request.resource.data.owner == resource.data.owner;
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || bootstrapping(uid);
      allow delete: if isAdmin() && uid != ownerId();
    }

    match /members/{uid} {
      allow read: if signedIn() && (uid == me() || isMember());
      allow create: if isAdmin() || bootstrapping(uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() && uid != ownerId();
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isMember());
      allow create, update: if signedIn() && uid == me();
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // old version's team cards (only used once, when the app upgrades itself)
    match /staff/{id} {
      allow read, write: if isAdmin();
    }

    match /shifts/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /briefings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /channels/{cid} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin();
      match /messages/{mid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.author == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow delete: if isMember() && (resource.data.author == me() || isAdmin());
      }
    }

    match /dms/{did} {
      allow read: if isMember() && me() in resource.data.members;
      allow create: if isMember()
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if isMember()
        && me() in resource.data.members
        && request.resource.data.members == resource.data.members;
      match /messages/{mid} {
        function participant() { return me() in get(/databases/$(database)/documents/dms/$(did)).data.members; }
        allow read: if isMember() && participant();
        allow create: if isMember() && participant()
          && request.resource.data.author == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow delete: if isMember() && resource.data.author == me();
      }
    }

    // ---- Time tracking ----
    // clock/{uid}: which record is open for each person (one at a time).
    match /clock/{uid} {
      allow read: if isMember() && (uid == me() || isAdmin());
      allow write: if isAdmin() || (uid == me() && isMember() && request.resource.data.keys().hasOnly(['open', 'at']) && (
        // checking in: nothing open before, and the new record is created in the same step
        (request.resource.data.open is string
          && (resource == null || resource.data.open == null
              || get(/databases/$(database)/documents/punches/$(resource.data.open)).data.outAt != null)
          && !exists(/databases/$(database)/documents/punches/$(request.resource.data.open))
          && getAfter(/databases/$(database)/documents/punches/$(request.resource.data.open)).data.uid == me())
        ||
        // checking out: the open record gets its check-out in the same step
        (request.resource.data.open == null && resource != null && resource.data.open is string
          && getAfter(/databases/$(database)/documents/punches/$(resource.data.open)).data.outAt != null)
      ));
    }

    // punches/{id}: one record per check-in. Employees can only create (time = server time) and
    // close their own open record (time = server time). Only managers can change anything else,
    // and every manager change must add to the history. Nobody can delete a record.
    match /punches/{pid} {
      allow read: if isMember() && (resource.data.uid == me() || isAdmin());
      allow create: if isMember() && (
        (request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'shiftId', 'day', 'week', 'inAt', 'outAt', 'status', 'approved', 'edits', 'manual', 'void', 'createdAt'])
          && request.resource.data.inAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.outAt == null
          && request.resource.data.status == 'open'
          && request.resource.data.approved == false
          && request.resource.data.manual == false
          && request.resource.data.void == false
          && request.resource.data.edits.size() == 0
          && getAfter(/databases/$(database)/documents/clock/$(me())).data.open == pid)
        ||
        (isAdmin() && request.resource.data.manual == true && request.resource.data.edits.size() >= 1)
      );
      allow update: if isMember() && (
        (resource.data.uid == me()
          && resource.data.outAt == null
          && resource.data.approved == false
          && resource.data.void == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt', 'status'])
          && request.resource.data.outAt == request.time
          && request.resource.data.status == 'done'
          && getAfter(/databases/$(database)/documents/clock/$(me())).data.open == null)
        ||
        (isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.edits.size() >= resource.data.edits.size()
          // changing times, break or removing a record must add a history entry
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inAt', 'outAt', 'breakMin', 'void'])
              || request.resource.data.edits.size() > resource.data.edits.size()))
      );
      allow delete: if false;
    }
  }
}
